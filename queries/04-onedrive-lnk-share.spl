```
Step 4 - The malicious shortcut is uploaded to bgist's OneDrive, shared with an anonymous link,
and the link is opened from several IPs.
```
index=botsv3 sourcetype=ms:o365:management Workload=OneDrive
    (Operation=FileUploaded OR Operation=AnonymousLinkCreated OR Operation=AnonymousLinkUsed OR Operation=SharingSet)
| where _time <= strptime("2018-08-20 10:05", "%Y-%m-%d %H:%M")
| eval file=coalesce(SourceFileName, ObjectId)
| table _time UserId ClientIP Operation file
| sort _time
